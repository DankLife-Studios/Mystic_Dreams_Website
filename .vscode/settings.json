{
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "prettier.tabWidth": 4,
    "prettier.useTabs": false,
    "prettier.singleQuote": true,
    "prettier.trailingComma": "es5",
    "prettier.arrowParens": "always",
    "prettier.printWidth": 120,
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[scss]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[less]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[sql]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[lua]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[graphql]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    // Lua Language Server - FiveM specific
    "Lua.runtime.version": "Lua 5.4",
    "Lua.diagnostics.globals": [
        "Citizen",
        "exports",
        "CreateThread",
        "Wait",
        "TriggerEvent",
        "TriggerServerEvent",
        "TriggerClientEvent",
        "RegisterNetEvent",
        "AddEventHandler",
        "AddStateBagChangeHandler",
        "SetStateBagValue",
        "GetCurrentResourceName",
        "GetResourceMetadata",
        "GetPlayerPed",
        "GetEntityCoords",
        "NetworkGetEntityFromNetworkId",
        "NetworkGetNetworkIdFromEntity",
        "lib",
        "QBCore",
        "ESX",
        "ox_inventory"
    ],
    "Lua.completion.enable": true,
    "Lua.completion.keywordSnippet": "Both",
    "Lua.hover.enable": true,
    "Lua.signatureHelp.enable": true,
    "Lua.diagnostics.enable": true,
    "Lua.workspace.checkThirdParty": false,
    // Editor quality of life
    "editor.inlayHints.enabled": "on",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.wordWrap": "off",
    "editor.rulers": [
        120
    ],
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.quickSuggestionsDelay": 0,
    // File nesting for FiveM resource structure
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "fxmanifest.lua": "__resource.lua",
        "*.client.lua": "${capture}.shared.lua",
        "*.server.lua": "${capture}.shared.lua"
    },
    // Exclude noise from file explorer
    "files.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/*.cache": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/.git": true
    }
}