# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Discord OAuth (Developer Portal → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Bot (Server Members Intent enabled, invited to guild)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CITIZEN_ROLE_ID=
DISCORD_WIKI_EDITOR_ROLE_ID=

# Read-only MySQL (Qbox game server database)
# mysql://mystic_web_readonly:PASSWORD@HOST/mystic_dreams
DATABASE_URL=

# Turso (libSQL) — wiki content & serverless data
#   turso db create database-mystic-website
#   turso db tokens create database-mystic-website
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Public
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/wtJNvB3bSK
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth.js v5
AUTH_URL=http://localhost:3000
